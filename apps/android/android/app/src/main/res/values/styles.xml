<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/boot_bg</item>
    </style>

    <!-- the page's theme (BridgeActivity switches to it). It runs behind clear bars (CalcBarsPlugin); until then the bars
         and the window wear the default look's background, never white or black -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/boot_bg</item>
        <item name="android:statusBarColor">@color/boot_bg</item>
        <item name="android:navigationBarColor">@color/boot_bg</item>
    </style>

    <!-- Opening: no splash. Android 12+ always draws a launch screen until the first frame; this one is just the
         background colour with no icon, and MainActivity drops it without the exit animation. Older Android shows the
         window background the same way. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/boot_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/blank</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/boot_bg</item>
        <item name="android:statusBarColor">@color/boot_bg</item>
        <item name="android:navigationBarColor">@color/boot_bg</item>
    </style>
</resources>
