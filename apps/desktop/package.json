{
  "name": "@calc/desktop",
  "productName": "Calculator",
  "version": "0.3.3",
  "description": "A private, offline calculator",
  "author": "userofit123",
  "homepage": "https://github.com/userofit123/calculator",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "main": "dist/main.cjs",
  "desktopName": "userofit123-calculator.desktop",
  "scripts": {
    "web": "pnpm --filter @calc/web exec vite build",
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "dist:linux": "pnpm run web && node build.mjs && electron-builder --linux --publish never -c.productName=userofit123-calculator",
    "dist:win": "pnpm run web && node build.mjs && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-builder-squirrel-windows": "26.18.0",
    "esbuild": "0.24.2",
    "typescript": "5.7.2"
  },
  "build": {
    "appId": "io.github.userofit123.calculator",
    "artifactName": "calculator-${version}-${arch}.${ext}",
    "copyright": "userofit123",
    "directories": {
      "output": "release",
      "buildResources": "build-res"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "publish": {
      "provider": "github",
      "owner": "userofit123",
      "repo": "calculator",
      "releaseType": "release"
    },
    "linux": {
      "executableName": "userofit123-calculator",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility;Calculator",
      "synopsis": "A private, offline calculator",
      "maintainer": "userofit123 <45289144+userofit123@users.noreply.github.com>",
      "vendor": "userofit123",
      "icon": "build-res/icons",
      "desktop": {
        "entry": {
          "Name": "Calculator",
          "Keywords": "calculator;calc;converter;currency;units;"
        }
      },
      "description": "Basic, scientific, financial and programming calculator with a unit and currency converter",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "userofit123-calculator"
    },
    "rpm": {
      "packageName": "userofit123-calculator"
    },
    "win": {
      "target": "nsis",
      "icon": "build-res/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "shortcutName": "Calculator",
      "uninstallDisplayName": "Calculator",
      "allowToChangeInstallationDirectory": true,
      "artifactName": "calculator-${version}-setup.${ext}"
    }
  }
}
